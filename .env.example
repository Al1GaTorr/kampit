# Server-only explicit PostgreSQL URI, preferred when nonempty.
# For Vercel Native Supabase, leave blank and use its managed POSTGRES_URL.
DATABASE_URL=
# Native integration-managed transaction-pooler URI; never browser code.
POSTGRES_URL=
# Required canonical production origin, e.g. https://your-project.vercel.app
# Local development: http://localhost:3000 (127.0.0.1 same port is also allowed).
APP_ORIGIN=
# Supabase project URL + publishable key. No service-role key is needed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
